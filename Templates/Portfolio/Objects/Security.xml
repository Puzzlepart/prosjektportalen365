<pnp:Security xmlns:pnp="http://schemas.dev.office.com/PnP/2022/09/ProvisioningSchema">
    <pnp:SiteGroups>
        <pnp:SiteGroup
            Title="{resource:Security_SiteGroup_AssistantUsers_Title}"
            Description="{resource:Security_SiteGroup_AssistantUsers_Description}"
            Owner="{associatedownergroupid}"
            AllowMembersEditMembership="false"
            OnlyAllowMembersViewMembership="true">
        </pnp:SiteGroup>
        <pnp:SiteGroup
            Title="{resource:Security_SiteGroup_PortfolioInsight_Title}"
            Description="{resource:Security_SiteGroup_PortfolioInsight_Description}"
            Owner="{associatedownergroupid}"
            AllowMembersEditMembership="false"
            OnlyAllowMembersViewMembership="true">
        </pnp:SiteGroup>
        <pnp:SiteGroup
            Title="{resource:Security_SiteGroup_PortfolioAdministrators_Title}"
            Description="{resource:Security_SiteGroup_PortfolioAdministrators_Description}"
            Owner="{associatedownergroupid}"
            AllowMembersEditMembership="false"
            OnlyAllowMembersViewMembership="true">
        </pnp:SiteGroup>
        <pnp:SiteGroup
            Title="{resource:Security_SiteGroup_IdeaProcessors_Title}"
            Description="{resource:Security_SiteGroup_IdeaProcessors_Description}"
            Owner="{associatedownergroupid}"
            AllowMembersEditMembership="false"
            OnlyAllowMembersViewMembership="true">
        </pnp:SiteGroup>
        <!-- No role on the hub itself: the group reads only the lists that include
             Lists/Security/MinimumReadSecurity.xml, and the folder SiteAssets/Konfigurasjon
             (Scripts/PostInstall.ps1). Lists with data about all projects are not among them. -->
        <pnp:SiteGroup
            Title="{resource:Security_SiteGroup_MinimumHubReadAccess_Title}"
            Description="{resource:Security_SiteGroup_MinimumHubReadAccess_Description}"
            Owner="{associatedownergroupid}"
            AllowMembersEditMembership="false"
            OnlyAllowMembersViewMembership="true">
        </pnp:SiteGroup>
    </pnp:SiteGroups>
</pnp:Security>