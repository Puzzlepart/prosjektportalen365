{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/pnpm-config.schema.json",
  "useWorkspaces": true,
  "resolutionMode": "highest",
  "autoInstallPeers": false,
  "strictPeerDependencies": false,
  "globalOverrides": {
    "caniuse-lite": "^1.0.30001700",

    // Fluent v9's focus-management stack, pinned so every Fluent package shares one copy of it
    // (two tabster instances on a page fight over focus). The pins must stay at or above what the
    // Fluent version in the solutions requires, so re-check them on every Fluent v9 bump:
    // `npm view @fluentui/react-tabster@<version> dependencies`. Raised 2026-09-22 for Fluent
    // 9.74.8, which needs react-tabster ^9.26.18, keyborg ^2.14.1 and tabster ^8.8.0; the previous
    // pins (9.26.13 / 2.6.0 / 8.7.0) would have forced versions below those minimums.
    // keyborg 3.x is deliberately not used: react-tabster 9.26.18 still asks for the 2.x line.
    "@fluentui/react-tabster": "9.26.18",
    "keyborg": "2.14.1",
    "tabster": "8.8.1",

    "@rushstack/heft": "1.3.2",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",

    // The PnP controls declare react and react-dom 17.0.1 as dependencies, not peers, and they are
    // bundled into our web parts. On React 18 pnpm would give them a React 17 of their own, and
    // with it their own copies of Fluent v8 and v9 (peer variants), bundled next to ours. Held to
    // the solutions' React so the copies are shared. Drop these when a controls release declares
    // React 18. SPFx's own packages also depend on React 17.0.1, but they are page externals and
    // never bundled, so they are left alone.
    "@pnp/spfx-controls-react>react": "18.3.1",
    "@pnp/spfx-controls-react>react-dom": "18.3.1",
    "@pnp/spfx-property-controls>react": "18.3.1",
    "@pnp/spfx-property-controls>react-dom": "18.3.1",

    // The security floors SPFx 1.24's project template sets (as npm `overrides`: `>=6.15.2`,
    // `>=11.1.1`). Held to their major here: uuid 12 and later ship ESM only, while 11 keeps a
    // CommonJS build for the tools that require() it (the SPFx Heft plugins, jest-junit, sockjs).
    "qs": "^6.15.2",
    "uuid": "^11.1.1",

    // Advisories in packages that come in through others (2026-10-08, phase 5). lodash 4.18 fixes
    // `_.template` code injection and two prototype pollutions; the override takes the copies the PnP
    // controls and react-gauge-component bring, which are bundled, onto it too. compression comes
    // with the `serve` CLI that react-gauge-component 1.x lists as a dependency (never bundled; 2.x
    // dropped it) and with webpack-dev-server. node-fetch 1 comes with isomorphic-fetch under
    // msgraph-helper's Graph client and runs only in Node: the browser build takes whatwg-fetch.
    "lodash": "^4.18.1",
    "compression": "^1.8.2",
    "isomorphic-fetch>node-fetch": "^2.7.0"
  },
  "globalOnlyBuiltDependencies": []
}
