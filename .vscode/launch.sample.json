{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug a page against npm run watch",
      "type": "chrome",
      "request": "launch",
      "url": "${input:pageUrl}?debugManifestsFile=https%3A%2F%2Flocalhost%3A4321%2Ftemp%2Fbuild%2Fmanifests.js&debug=true&noredir=true",
      "webRoot": "${workspaceFolder}/SharePointFramework/${input:solution}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///.././src/*": "${webRoot}/src/*",
        "webpack:///../../*": "${webRoot}/../*"
      },
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--user-data-dir=${workspaceFolder}/.vscode/chrome-debug-user-data"
      ]
    }
  ],
  "inputs": [
    {
      "id": "solution",
      "type": "pickString",
      "description": "The solution npm run watch is running in",
      "options": [
        "PortfolioWebParts",
        "ProjectWebParts",
        "ProgramWebParts",
        "PortfolioExtensions",
        "ProjectExtensions"
      ],
      "default": "PortfolioWebParts"
    },
    {
      "id": "pageUrl",
      "type": "promptString",
      "description": "The SharePoint page to debug on, without a query string",
      "default": "https://contoso.sharepoint.com/sites/pp365/SitePages/Portefoljeoversikt.aspx"
    }
  ]
}
