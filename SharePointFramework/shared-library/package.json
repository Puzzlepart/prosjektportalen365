{
  "name": "pp365-shared-library",
  "version": "1.14.0",
  "sideEffects": false,
  "private": false,
  "main": "lib/index.js",
  "scripts": {
    "build": "heft test --clean --production && npm run test:runtime && heft package-solution --production",
    "build:test": "node ../.tasks/build.js --channel test",
    "build:i18n": "node ../.tasks/build.js --channel i18n",
    "build:kurs": "node ../.tasks/build.js --channel kurs",
    "postversion": "heft build --production && npm publish",
    "lint": "npm run prettier && eslint ./src --fix",
    "prettier": "prettier \"**/*.ts*\" --write --log-level warn --config ../.prettierrc.yaml",
    "validate-loc": "node ../.tasks/validateLoc.js --path ./src/loc --interface ISharedLibraryStrings --dts mystrings.d.ts --output ./localization-report.md --summary",
    "clean": "heft clean",
    "test": "heft test && npm run test:runtime",
    "test:runtime": "node --test \"test/runtime/*.test.mjs\""
  },
  "dependencies": {
    "@microsoft/sp-application-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
