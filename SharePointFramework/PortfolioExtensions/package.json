{
  "name": "pp365-portfolioextensions",
  "version": "1.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Puzzlepart/prosjektportalen365.git",
    "directory": "SharePointFramework/PortfolioExtensions"
  },
  "license": "MIT",
  "scripts": {
    "watch": "heft start --nobrowser",
    "prewatch": "node ../.tasks/pre-watch.js",
    "postwatch": "node ../.tasks/post-watch.js",
    "build": "heft test --clean --production && heft package-solution --production",
    "build:test": "node ../.tasks/build.js --channel test",
    "build:i18n": "node ../.tasks/build.js --channel i18n",
    "build:kurs": "node ../.tasks/build.js --channel kurs",
    "postversion": "heft build --production && npm publish",
    "lint": "npm run prettier && eslint ./src --fix",
    "prettier": "prettier \"**/*.ts*\" --write --log-level warn --config ../.prettierrc.yaml",
    "validate-loc": "node ../.tasks/validateLoc.js --path ./src/loc --interface IPortfolioExtensionsStrings --dts mystrings.d.ts --output ./localization-report.md --summary",
    "clean": "heft clean",
    "start": "heft start",
    "eject-webpack": "heft eject-webpack",
    "test": "heft test"
  },
  "dependencies": {
    "@fluentui/react": "8.106.4",
    "@microsoft/decorators": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-dialog": "1.23.2",
    "@microsoft/sp-page-context": "1.23.2",
    "@microsoft/sp-application-base": "1.23.2",
    "@microsoft/sp-listview-extensibility": "1.23.2",
    "react-markdown": "^8.0.3",
    "rehype-raw": "^6.1.1",
    "@pnp/core": "4.21.0",
    "@pnp/logging": "4.21.0",
    "@pnp/sp": "4.21.0",
    "pp365-shared-library": "workspace:*",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.8.1",
    "underscore": "~1.13.6",
    "@pnp/queryable": "4.21.0",
    "@fluentui/react-components": "~9.72.10",
    "@fluentui/react-icons": "~2.0.317",
    "react-gauge-component": "~1.2.61",
    "jszip": "3.10.1",
    "sp-js-provisioning": "1.4.0"
  },
  "devDependencies": {
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@testing-library/dom": "8.20.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "14.6.7",
    "@types/heft-jest": "1.0.2",
    "@types/jest": "30.0.0",
    "@types/lodash": "~4.14.195",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/sharepoint": "2016.1.10",
    "@types/underscore": "~1.11.5",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "7.1.2",
    "dotenv": "~16.1.3",
    "eslint": "9.37.0",
    "pp365-eslint-config": "workspace:*",
    "pp365-jest-config": "workspace:*",
    "prettier": "3.9.7",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  }
}
