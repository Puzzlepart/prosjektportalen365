{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors measured in a full run of the 101 tests
  // (2026-10-09, 39.92/79.10/71.35/39.92), rounded down and one point under, since CI counts a little
  // differently from a local run (Install/Build-Release.ps1 prints CI's figures per solution).
  // Raise them when coverage grows; never lower them.
  "coverageThreshold": {
    "global": {
      "statements": 38,
      "branches": 78,
      "functions": 70,
      "lines": 38
    }
  }
}
