{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors measured after phase 5 slice 2a (2026-10-06,
  // 61.15/71.31/47.85/61.15 on 160 tests), rounded down, and branches a point lower for being
  // within half a point. Raise them when coverage grows; never lower them.
  "coverageThreshold": {
    "global": {
      "statements": 61,
      "branches": 70,
      "functions": 47,
      "lines": 61
    }
  }
}
