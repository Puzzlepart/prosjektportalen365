{
  "extends": "./node_modules/@microsoft/spfx-web-build-rig/profiles/default/tsconfig-base.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": false,
    "downlevelIteration": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "dom",
      "es5",
      "es2015.core",
      "es2015.collection",
      "es2015.iterable",
      "es2015.promise",
      "es2015.proxy",
      "es2016",
      "es2017.object"
    ],
    "baseUrl": "src",
    "paths": {
      "icons": [
        "icons"
      ],
      "components": [
        "components"
      ],
      "models": [
        "models"
      ],
      "interfaces": [
        "interfaces"
      ],
      "types": [
        "types"
      ],
      "data": [
        "data"
      ],
      "utils": [
        "utils"
      ]
    }
  }
}
