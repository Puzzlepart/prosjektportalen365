{
  "name": "pp365-portfoliowebparts",
  "version": "1.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Puzzlepart/prosjektportalen365.git",
    "directory": "SharePointFramework/PortfolioWebParts"
  },
  "license": "MIT",
  "scripts": {
    "watch": "heft start --nobrowser",
    "prewatch": "node ../.tasks/pre-watch.js",
    "postwatch": "node ../.tasks/post-watch.js",
    "build": "heft test --clean --production && heft package-solution --production",
    "build:test": "node ../.tasks/build.js --channel test",
    "build:i18n": "node ../.tasks/build.js --channel i18n",
    "build:kurs": "node ../.tasks/build.js --channel kurs",
    "postversion": "heft build --production && npm publish",
    "lint": "npm run prettier && eslint ./src --fix",
    "prettier": "prettier \"**/*.ts*\" --write --log-level warn --config ../.prettierrc.yaml",
    "validate-loc": "node ../.tasks/validateLoc.js --path ./src/loc --interface IPortfolioWebPartsStrings --dts mystrings.d.ts --output ./localization-report.md --summary",
    "clean": "heft clean",
    "start": "heft start",
    "eject-webpack": "heft eject-webpack",
    "test": "heft test"
  },
  "dependencies": {
    "@microsoft/decorators": "1.24.0-rc.0",
    "@microsoft/sp-core-library": "1.24.0-rc.0",
    "@microsoft/sp-lodash-subset": "1.24.0-rc.0",
    "@microsoft/sp-office-ui-fabric-core": "1.24.0-rc.0",
    "@microsoft/sp-page-context": "1.24.0-rc.0",
    "@microsoft/sp-property-pane": "1.24.0-rc.0",
    "@microsoft/sp-webpart-base": "1.24.0-rc.0",
    "@microsoft/sp-http": "1.24.0-rc.0",
    "@pnp/logging": "4.21.0",
    "@pnp/sp": "4.21.0",
    "@pnp/spfx-controls-react": "3.25.0",
    "@pnp/spfx-property-controls": "3.24.0",
    "@reduxjs/toolkit": "~2.13.0",
    "@types/array-sort": "1.0.0",
    "array-sort": "1.0.0",
    "clean-deep": "3.0.2",
    "interactjs": "1.6.2",
    "moment": "~2.31.0",
    "msgraph-helper": "0.8.3",
    "object-assign": "4.1.1",
    "pp365-shared-library": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.8.1",
    "underscore": "~1.13.6",
    "lodash": "~4.18.1",
    "array-unique": "0.3.2",
    "@hello-pangea/dnd": "~16.6.0",
    "@pnp/core": "4.21.0",
    "@pnp/queryable": "4.21.0",
    "@fluentui/react-components": "~9.74.8",
    "@fluentui/react-icons": "~2.0.341",
    "use-image-color": "~0.0.9",
    "react-error-boundary": "~4.0.11",
    "react-window": "~1.8.10",
    "react-virtualized-auto-sizer": "~1.0.24",
    "react-gauge-component": "~1.2.61"
