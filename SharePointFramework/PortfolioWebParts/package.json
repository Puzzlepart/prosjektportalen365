    "css-loader": "7.1.2",
    "dotenv": "~16.1.3",
    "eslint": "9.37.0",
    "pp365-eslint-config": "workspace:*",
    "pp365-jest-config": "workspace:*",
    "pp365-projectwebparts": "workspace:*",
    "prettier": "3.9.7",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  }
