SERVE_CHANNEL=main
SERVE_BUNDLE_REGEX=
# Tilgjengelige kanaler: main, test, i18n
# SERVE_ENVIRONMENT velger hvilket miljø fra environments.json som blir "default" i config/serve.json.
# Kjør et annet miljø uten å endre .env: npm run watch -- --serve-config <navn>
SERVE_ENVIRONMENT=
# Fyller ut {tenantDomain} i serve.json (f.eks. contoso.sharepoint.com)
SPFX_SERVE_TENANT_DOMAIN=
# Sider å feilsøke på fra VS Code når solution-mappen er åpnet som arbeidsområde: "<navn>,<side-URL>;<navn>,<side-URL>".
# prewatch lager .vscode/launch.json av dem (bare når den ikke finnes). Fra repo-roten: bruk .vscode/launch.sample.json der.
LAUNCH_CONFIGURATIONS=
