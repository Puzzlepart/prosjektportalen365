{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors from CI's full run (run 40377546556,
  // 2026-10-26, 48.93/80.57/71.01/48.93), rounded down and one point under, since CI
  // counts a little differently from a local run (Install/Build-Release.ps1 prints CI's figures
