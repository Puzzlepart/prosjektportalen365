{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors measured after the program administration's
  // lists moved to the portfolio overview's grid (2026-10-09, 45.25/80.70/67.18/45.25 on 57
  // tests), rounded down, and branches a point lower for being within one point. Raise them when
  // coverage grows; never lower them.
  "coverageThreshold": {
    "global": {
      "statements": 41,
      "branches": 76,
      "functions": 63,
      "lines": 41
    }
  }
}
