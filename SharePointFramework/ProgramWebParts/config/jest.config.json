{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors measured in a full run of the 65 tests
  // (2026-10-19, 47.32/79.37/70.58/47.32), rounded down and one point under, since CI counts a little
  // differently from a local run (Install/Build-Release.ps1 prints CI's figures per solution).
  // The branch floor stays at 79, set when they were 80.34. Raise them when coverage grows; never
  // lower them.
  "coverageThreshold": {
    "global": {
      "statements": 46,
      "branches": 79,
      "functions": 69,
      "lines": 46
    }
  }
}
