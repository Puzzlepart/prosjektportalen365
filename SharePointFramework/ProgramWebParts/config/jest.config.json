{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors measured at phase 4, slice 4 (2026-10-02),
  // rounded down. Raise them when coverage grows; never lower them.
  "coverageThreshold": {
    "global": {
      "statements": 38,
      "branches": 72,
      "functions": 60,
      "lines": 38
    }
  }
}
