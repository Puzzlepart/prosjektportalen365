    "directory": "SharePointFramework/ProjectWebParts"
  },
  "license": "MIT",
  "scripts": {
    "watch": "heft start --nobrowser",
    "prewatch": "node ../.tasks/pre-watch.js",
    "postwatch": "node ../.tasks/post-watch.js",
    "build": "heft build --clean --production && heft package-solution --production",
    "build:test": "node ../.tasks/build.js --channel test",
    "build:i18n": "node ../.tasks/build.js --channel i18n",
    "build:kurs": "node ../.tasks/build.js --channel kurs",
    "postversion": "heft build --production && npm publish",
    "lint": "npm run prettier && eslint ./src --fix",
    "prettier": "prettier \"**/*.ts*\" --write --log-level warn --config ../.prettierrc.yaml",
    "validate-loc": "node ../.tasks/validateLoc.js --path ./src/loc --interface IProjectWebPartsStrings --dts mystrings.d.ts --output ./localization-report.md --summary",
    "clean": "heft clean",
    "start": "heft start",
    "eject-webpack": "heft eject-webpack"
  },
