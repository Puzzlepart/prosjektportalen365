{
  // Shared Jest setup for all pp365 solutions; see SharePointFramework/.jest-config/README.md
  "extends": "pp365-jest-config/jest-shared.config.json",
  // Coverage may only rise: these are the floors measured after the matrix web parts' tests
  // (2026-10-09, 50.78/72.58/55.63/50.78 on 210 tests), rounded down. Raise them when coverage
  // grows; never lower them.
  "coverageThreshold": {
    "global": {
      "statements": 45,
      "branches": 70,
      "functions": 50,
      "lines": 45
    }
  }
}
