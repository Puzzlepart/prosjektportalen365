# Copy to e2e/.env for local runs. CI provides the same variables from repository variables/secrets.
# Portfolio hub under test (CI: the SP_URL_TEST repository variable).
E2E_BASE_URL=https://<tenant>.sharepoint.com/sites/<portfolio-hub>
# Dedicated end-to-end test user (CI: E2E_USERNAME / E2E_PASSWORD secrets). Must be excluded from MFA.
E2E_USERNAME=pp365-e2e@<tenant>.onmicrosoft.com
E2E_PASSWORD=
# An existing, fully provisioned project in the hub (CI: E2E_PROJECT_URL variable). Optional.
E2E_PROJECT_URL=https://<tenant>.sharepoint.com/sites/<a-test-project>
# Page name overrides for an English-provisioned hub, optional.
# E2E_PAGE_HOME=SitePages/Home.aspx
# E2E_PAGE_PROJECT_STATUS=SitePages/ProjectStatus.aspx
# E2E_PAGE_TIMELINE=SitePages/ProjectTimeline.aspx
# E2E_PAGE_BENEFITS=SitePages/BenefitOverview.aspx
