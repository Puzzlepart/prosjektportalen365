# Copy to e2e/.env for local runs. CI provides the same variables from repository variables/secrets.
# Portfolio hub under test (CI: the SP_URL_TEST repository variable).
E2E_BASE_URL=https://<tenant>.sharepoint.com/sites/<portfolio-hub>
# Dedicated end-to-end test user (CI: E2E_USERNAME / E2E_PASSWORD secrets). Must be excluded from MFA.
E2E_USERNAME=pp365-e2e@<tenant>.onmicrosoft.com
E2E_PASSWORD=
# An existing, fully provisioned project in the hub (CI: E2E_PROJECT_URL variable). Optional; the
# project tests skip with a message when it is missing or points at the hub.
E2E_PROJECT_URL=https://<tenant>.sharepoint.com/sites/<a-test-project>
# An existing program site in the hub, with at least one child project (CI: E2E_PROGRAM_URL variable).
# Optional; the program tests skip with a message when it is missing or points at the hub.
E2E_PROGRAM_URL=https://<tenant>.sharepoint.com/sites/<a-test-program>
# Page name overrides, optional. Each test tries these first, then its built-in Norwegian/English
# candidates, and skips with the list of existing pages when none is found.
# E2E_PAGE_HOME=Home.aspx
# E2E_PAGE_OVERVIEW=Porteføljeoversikt.aspx
# E2E_PAGE_PROJECT_STATUS=Porteføljeinnsikt.aspx
# E2E_PAGE_TIMELINE=Prosjekttidslinje.aspx
# E2E_PAGE_BENEFITS=Nytteoversikt.aspx
# Local runs only: set to 1 to keep the browser open on failure (npx playwright test --headed --debug does the same).
# PWDEBUG=1
