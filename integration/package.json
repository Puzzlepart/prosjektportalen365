{
  "name": "pp365-integration",
  "version": "1.14.0",
  "private": true,
  "type": "module",
  "description": "Integration tests for Prosjektportalen 365: the shared library's data layer, run in Node against the test tenant's sites, asserting on what SharePoint returns and stores.",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:ci": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\" && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml \"tests/**/*.test.ts\"",
    "lint": "echo \"No linting configured\"",
    "validate-loc": "echo \"No localization in pp365-integration\""
  },
  "devDependencies": {
    "@azure/msal-node": "7.0.1",
    "@pnp/core": "4.21.0",
    "@pnp/queryable": "4.21.0",
    "@pnp/sp": "4.21.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.3",
    "@types/node-forge": "1.3.14",
    "dotenv": "17.2.3",
    "jsdom": "26.1.0",
    "node-forge": "1.4.0",
    "pp365-jest-config": "workspace:*",
    "pp365-projectwebparts": "workspace:*",
    "pp365-shared-library": "workspace:*",
    "typescript": "~5.8.3"
  }
}
