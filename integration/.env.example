# Copy to .env (gitignored) and fill in. CI sets the same variables from the repository's
# variables and secrets (.github/workflows/ci-channel-test.yml, job "Integration tests").

# The test hub, a program on it, and the project reserved for these tests' writes. Nothing else
# writes to that project: never point it at the project the browser suite or a hand test uses.
INTEGRATION_HUB_URL=https://<tenant>.sharepoint.com/sites/<portfolio-hub>
INTEGRATION_PROGRAM_URL=https://<tenant>.sharepoint.com/sites/<a-test-program>
INTEGRATION_PROJECT_URL=https://<tenant>.sharepoint.com/sites/<the-reserved-test-project>

# The language of the string bundles the library loads: nb-no (default) or en-us. It must be the
# sites' language: the library finds the hub's lists by their titles in it.
# INTEGRATION_LOCALE=nb-no

# A test skips, with the reason, when a site or the sign-in it needs is not set; strict fails it
# instead (CI, where a suite skipped whole would pass having tested nothing).
# INTEGRATION_STRICT=true

# The tests of the templates' state (tests/template.test.ts) run only when the hub has the
# templates of the code under test: CI sets this after its full upgrade. Set it to check the hub.
# INTEGRATION_TEMPLATES_APPLIED=true

# Sign-in, by what is set (or forced with INTEGRATION_AUTH=certificate|cookies):
#  - certificate: as the CI app, app-only. CI_CERT_BASE64 is the PFX, base64, without a password.
# CI_TENANT=<tenant>.onmicrosoft.com
# CI_CLIENT_ID=
# CI_CERT_BASE64=
#  - cookies: as the e2e user, from the browser suite's sign-in. Create or renew the file with
#    `npx playwright test --project=setup` in e2e/; this is the default file.
# INTEGRATION_COOKIES_FILE=../e2e/.auth/user.json

# The user an app-only run acts for where the library asks for one (ensureUser): the e2e user.
# INTEGRATION_USER=pp365-e2e@<tenant>.onmicrosoft.com
